<content-type>
    <display-name>Melding til redaktører</display-name>
    <description>Brukes til å legge melding på dashboard (oppstartsside) i Enonic XP</description>
    <super-type>base:unstructured</super-type>
    <form>
        <input type="HtmlArea" name="text">
            <label>Brødtekst</label>
            <occurrences minimum="1" maximum="1"/>
            <config>
                <include>Undo Redo</include>
                <exclude>JustifyBlock Underline</exclude>
                <allowHeadings>h3 h4 normal</allowHeadings>
            </config>
        </input>
        <field-set>
            <label>Eventuelle underseksjoner</label>
            <items>
                <input type="HtmlArea" name="subText">
                    <label>Tekst etter underseksjoner</label>
                    <help-text>Vil vises under eventuelle underseksjoner</help-text>
                    <occurrences minimum="0" maximum="1"/>
                    <config>
                        <include>Undo Redo</include>
                        <exclude>JustifyBlock Underline</exclude>
                        <allowHeadings>h3 h4 normal</allowHeadings>
                    </config>
                </input>
            </items>
        </field-set>
    </form>
</content-type>
