        "@enonic-types/lib-cluster": "catalog:",
        "@enonic-types/lib-common": "catalog:",
        "@enonic-types/lib-content": "catalog:",
        "@enonic-types/lib-context": "catalog:",
        "@enonic-types/lib-event": "catalog:",
        "@enonic-types/lib-grid": "catalog:",
        "@enonic-types/lib-io": "catalog:",
        "@enonic-types/lib-node": "catalog:",
        "@enonic-types/lib-portal": "catalog:",
        "@enonic-types/lib-project": "catalog:",
        "@enonic-types/lib-repo": "catalog:",
        "@enonic-types/lib-scheduler": "catalog:",
        "@enonic-types/lib-schema": "catalog:",
        "@enonic-types/lib-task": "catalog:",
