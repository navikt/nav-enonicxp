{
    "name": "navno-enonicxp",
    "version": "2.52.3",
    "engines": {
        "node": "26"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "scripts": {
        "test": "pnpm --filter nav-enonicxp-tests run test",
        "build": "pnpm run lint && pnpm run babel",
        "lint": "eslint ./src/main/resources --ext=ts --quiet && tsc --noemit",
        "babel": "babel src/main/resources --out-dir=build/resources/main --no-copy-ignored --extensions \".ts\"",
        "sandbox:import": "node scripts/sandbox/import.mjs",
        "sandbox:dump": "node scripts/sandbox/dump.mjs",
        "sandbox:create": "node scripts/sandbox/create.mjs",
        "sandbox:config": "node scripts/sandbox/config.mjs",
        "sandbox:deploy": "node scripts/sandbox/deploy.mjs",
        "sandbox:test": "node --test scripts/sandbox/tests/*.test.mjs",
        "sandbox:lint": "eslint scripts/sandbox --quiet"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/navikt/nav-enonicxp.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/navikt/nav-enonicxp/issues"
    },
    "homepage": "https://github.com/navikt/nav-enonicxp#readme",
    "type": "module",
    "devDependencies": {
        "@anders-nom/babel-plugin-import-graphql-string": "catalog:",
        "@babel/cli": "catalog:",
        "@babel/core": "catalog:",
        "@babel/preset-env": "catalog:",
        "@babel/preset-typescript": "catalog:",
        "@enonic-types/core": "catalog:",
        "@enonic-types/global": "catalog:",
        "@enonic-types/lib-auditlog": "catalog:",
